sl_sleeptimer_timer_handle_t newConnectionTimer;


void newConnectionTimerCallback(sl_sleeptimer_timer_handle_t *handle, void *data){
  (void)data;
  (void)handle;

  if(blink_count < (uint8_t)120U){
      sl_led_toggle(&sl_led_led0);
      blink_count++;

  }else{
      blink_expired = true;

  }
}



void app_button_press_cb(uint8_t button, uint8_t duration){
//    QStateHandler state;
//    state = QMsm_state(QMsm_bt_SPC51_p);

    app_log_info("Pressed.\n");

    button_pressed = true;
    buttonEvt.duration = duration;
    buttonEvt.keyId = button;

}



// function call back for application reply if sleeping is okay
bool app_is_ok_to_sleep(void)
{
  if (blink_expired | update_timer_expired | button_pressed | bsl_read)
    return false;
  else
    return true;
}


