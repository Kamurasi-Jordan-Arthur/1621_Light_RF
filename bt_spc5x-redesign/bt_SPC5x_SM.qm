        <action>app_log_info(&quot; NEXT FIRMWARE UPDATE \n&quot;);


app_log_info(&quot; Fraction Sent %lu / %lu  &quot;,g_ota_data.bytes_sent,g_ota_data.total_firmware_size);


app_assert_s(BSL_RX_buffer[HDR_LEN_CMD_BYTES + ACK_BYTE - 1] == eBSL_success);
//   printf(&quot;\n&quot;);

LED_DEB
</action>
        <choice>
         <guard brief="else">else</guard>
         <action>app_assert_s(g_ota_data.bytes_sent &lt; g_ota_data.total_firmware_size);

me-&gt;sc = sl_bt_gatt_server_send_user_write_response(me-&gt;update_connection,
                                                   gattdb_firmware_update_cmd,
                                                   0U);
app_assert_status(me-&gt;sc);

app_log_info(&quot;Waiting for other chunks \n&quot;);</action>
         <choice_glyph conn="152,78,4,-1,-11">
          <action box="-6,-9,6,2"/>
         </choice_glyph>
        </choice>
        <choice>
         <guard brief="UnwritenBytesToWrite!!">me-&gt;ui16BytesToWrite</guard>
         <action>app_log_info(&quot;UnwritenBytesToWrite&quot;);
bt_SPC51_Host_BSL_writeMemory(me);
</action>
         <choice_glyph conn="152,78,5,-1,10">
          <action box="0,1,17,2"/>
         </choice_glyph>
        </choice>
        <choice target="../../../5">
         <guard brief="MORE_DATA!!">g_ota_data.bytes_sent == g_ota_data.total_firmware_size </guard>
         <action>me-&gt;sc = sl_bt_gatt_server_send_user_write_response(me-&gt;update_connection,
                                                   gattdb_firmware_update_cmd,
                                                   0U);
app_assert_status(me-&gt;sc);</action>
         <choice_glyph conn="152,78,4,0,16">
          <action box="-13,8,15,2"/>
         </choice_glyph>
        </choice>
